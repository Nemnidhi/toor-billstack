# BillStack Backend Production Environment Template
# Copy to .env.production on the server and fill real values there.
# Never commit real secrets. Live providers remain disabled by default.

# ---------------------------------------------------------------------------
# Core / Server
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
BILLSTACK_DEPLOYMENT_MODE=SAAS
CLIENT_URL=https://app.example.com
CRM_RETURN_URLS=https://crm.example.com
FRONTEND_ORIGINS=https://app.example.com
BASE_URL=https://api.example.com
API_BASE_URL=https://api.example.com
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=300

# ---------------------------------------------------------------------------
# Self-hosted default workspace profile
# Used only when BILLSTACK_DEPLOYMENT_MODE=SELF_HOSTED.
# Override these per client without changing source code.
# ---------------------------------------------------------------------------
BILLSTACK_SELF_HOSTED_INDUSTRY_CODE=REAL_ESTATE
BILLSTACK_SELF_HOSTED_PLAYER_TYPE_CODE=BROKER
BILLSTACK_SELF_HOSTED_BUSINESS_MODEL=SERVICE
BILLSTACK_SELF_HOSTED_SELECTED_NEEDS=QUOTATIONS,COMMUNICATIONS,RECURRING_BILLING,APPOINTMENTS,GST,EXPENSES
BILLSTACK_SELF_HOSTED_SELECTED_MODULES=
BILLSTACK_SELF_HOSTED_BUSINESS_SIZE=SMALL
BILLSTACK_SELF_HOSTED_USERS=1
BILLSTACK_SELF_HOSTED_LOCATIONS=1
BILLSTACK_SELF_HOSTED_GST_REGISTERED=false

# ---------------------------------------------------------------------------
# Database
# MongoDB must support transactions in production: replica set or sharded.
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://user:password@mongo-host:27017/billstack?replicaSet=rs0

# ---------------------------------------------------------------------------
# Authentication / JWT
# Use long random secrets. Do not reuse development secrets.
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-32-plus-character-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
REFRESH_COOKIE_NAME=billstack_refresh_token

# ---------------------------------------------------------------------------
# Super Admin
# ---------------------------------------------------------------------------
SUPER_ADMIN_JWT_SECRET=replace-with-separate-32-plus-character-random-secret
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-strong-password
# Optional: two-step sign-in for the super admin (base32, from: node scripts/make-totp-secret.js).
SUPER_ADMIN_TOTP_SECRET=

# ---------------------------------------------------------------------------
# Google OAuth
# Disabled by default. Enable only after configuring Google Identity.
# ---------------------------------------------------------------------------
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# SMTP / Email
# Disabled by default. Enable only after configuring SMTP.
# ---------------------------------------------------------------------------
EMAIL_SEND_ENABLED=false
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=
EMAIL_REPLY_TO=

# ---------------------------------------------------------------------------
# Razorpay
# Live billing disabled by default. Enable only after configuring live keys,
# webhook secret, and production plan IDs.
# ---------------------------------------------------------------------------
RAZORPAY_LIVE_BILLING_ENABLED=false
BILLING_LIVE_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_BASIC_ID=
RAZORPAY_PLAN_PRO_ID=
RAZORPAY_PLAN_ENTERPRISE_ID=

# ---------------------------------------------------------------------------
# WhatsApp
# Sending disabled by default. Enable only after provider contract/config.
# ---------------------------------------------------------------------------
WHATSAPP_SEND_ENABLED=false
WHATSAPP_API_BASE_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_ACCOUNT_ID=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_PROVIDER_NAME=NEMNIDHI_WHATSAPP

# The company's WhatsApp app (oor-whatsapp). When both are set, WhatsApp messages (invoice issued,
# payment reminders, payment received) go through it instead of the provider above: one number,
# Meta-approved templates, sent only to customers ticked "Agreed to WhatsApp messages". The app sets
# BILLSTACK_BASE_URL to this API and BILLSTACK_SHARED_SECRET to the same secret (32+ characters).
WHATSAPP_APP_URL=
WHATSAPP_APP_SECRET=
# Optional: only these business ids send through the app (comma-separated); empty = all of them.
WHATSAPP_APP_BUSINESS_IDS=

# 64 hex characters (32 random bytes). Encrypts secrets a business saves in BillStack, such as its own
# Razorpay key secret and webhook secret for customer payment links. Keep it; losing it means those
# keys must be entered again.
BILLSTACK_DATA_KEY=

# ---------------------------------------------------------------------------
# External Integrations / Webhooks
# Disabled by default.
# ---------------------------------------------------------------------------
INTEGRATION_API_ENABLED=false
INTEGRATION_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Worker / Scheduler
# ---------------------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=30000
WORKER_BATCH_SIZE=25
REMINDER_LOCK_TTL_MS=300000
WORKER_ID=billstack-worker-1
BILLSTACK_DEFAULT_TIMEZONE=Asia/Kolkata
